{
  "name": "WeMaAd-Nextjs-website",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "minify-css": "node -e \"const C=require('clean-css'),fs=require('fs');['dark','light','animate'].forEach(n=>{const p='public/css/'+n+'.css';const r=new C({level:1,inline:false}).minify(fs.readFileSync(p,'utf8'));fs.writeFileSync(p,r.styles);console.log(n+'.css →',r.styles.length,'bytes');});\"",
    "prebuild": "npm run minify-css",
    "build": "next build",
    "export": "next build && next export",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "formik": "^2.2.9",
    "next": "12.0.7",
    "react": "17.0.2",
    "react-circular-progressbar": "^2.0.4",
    "react-countup": "^6.1.0",
    "react-dom": "17.0.2",
    "react-modal-video": "^1.2.8",
    "react-slick": "^0.28.1",
    "react-visibility-sensor": "^5.1.1",
    "slick-carousel": "^1.8.1",
    "swiper": "^7.4.1"
  },
  "devDependencies": {
    "clean-css-cli": "^5.6.3",
    "eslint": "8.6.0",
    "eslint-config-next": "12.0.7"
  }
}
